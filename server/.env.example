CLIENT_URL="http://localhost:5173"

# For cloudinary asset storage
CLOUDINARY_KEY=
CLOUDINARY_SECRET=
CLOUD_NAME=

# Better Auth
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public URL of this API. Google redirects to $BETTER_AUTH_URL/api/auth/callback/google
BETTER_AUTH_URL=http://localhost:4000
# Domain the session cookie is shared on in production
AUTH_COOKIE_DOMAIN=.thakur.dev
# Comma-separated passkey origins for the Android app builds:
# android:apk-key-hash:<base64url SHA-256 of the signing certificate>
PASSKEY_ANDROID_ORIGINS=

# For google auth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_WEB_CLIENT_ID from app/constants.ts, if it differs from GOOGLE_CLIENT_ID
GOOGLE_MOBILE_CLIENT_ID=

NODE_ENV=development

# For email sending
RESEND_API_KEY=r
RESEND_EMAIL=

# For database postgres 
# Get from supabase
DATABASE_URL=

# Keys the old auth used to encrypt 2FA secrets. Needed only while running `pnpm migrate:auth`.
ENCRYPTION_KEY=
ENCRYPTION_IV=

# Music sync service
SONG_API_URL=https://song.thakur.dev
MUSIC_SYNC_INTERVAL_HOURS=6
MUSIC_SYNC_BATCH_SIZE=3
MUSIC_SYNC_BATCH_DELAY_MS=500
MUSIC_SYNC_MODE=modules
# Play-next engine. Set to hybrid to add editorial playlist links; anything else keeps the scorer.
RECO_ENGINE=
# Available modes: modules, full
# modules = homepage data only (~100 songs/sync)
# full = all sources (~400-800 songs/sync)

RAZORPAY_TEST_API_KEY=
RAZORPAY_TEST_API_SECRET=
RAZORPAY_WEBHOOK_SECRET=

CLOUDFLARE_TURN_TOKEN_ID=
CLOUDFLARE_TURN_API_TOKEN=

#  To restrict access to admin update path and url
ADMIN_EMAIL=

# To upload the app updates to r2
R2_ENDPOINT=https://<your-cloudflare-account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=<r2-token-access-key-id>
R2_SECRET_ACCESS_KEY=<r2-token-secret-access-key>
R2_BUCKET_NAME=<r2-bucket-name>
R2_PUBLIC_URL=https://<your-custom-domain-or-r2-public-subdomain>

KLIPY_API_KEY=

# Refuse sockets that have no valid session. Leave unset while app versions up to 1.6.x are in
# use: they connect without one, for music rooms.
SOCKET_REQUIRE_SESSION=
