{
  "name": "syncvibe",
  "private": true,
  "type": "module",
  "module": "index.ts",
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "build": "pnpm -r --parallel run build",
    "format": "oxfmt --check",
    "format:fix": "oxfmt --write",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "android": "pnpm --filter app run android",
    "ios": "pnpm --filter app run ios"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0"
  },
  "packageManager": "pnpm@12.3.4"
}
