+        // Raw WebAuthn JSON in and out, the way Credential Manager takes it. The Record + Gson path
+        // above serialises Kotlin fields by name, which R8 renames in minified release builds.
+        AsyncFunction("createJson") { requestJson: String, promise: Promise ->
+            val credentialManager =
+                CredentialManager.create(appContext.reactContext?.applicationContext!!)
+            mainScope.launch {
+                try {
+                    val activity = appContext.currentActivity
+                        ?: throw CreateCredentialUnknownException("No activity to show the passkey prompt")
+                    val result = credentialManager.createCredential(
+                        activity, CreatePublicKeyCredentialRequest(requestJson)
+                    )
+                    promise.resolve(
+                        result.data.getString("androidx.credentials.BUNDLE_KEY_REGISTRATION_RESPONSE_JSON")
+                    )
+                } catch (e: CreateCredentialException) {
+                    promise.reject("Passkey Create", getRegistrationException(e), e)
+                }
+            }
+        }
+
+        AsyncFunction("getJson") { requestJson: String, promise: Promise ->
+            val credentialManager =
