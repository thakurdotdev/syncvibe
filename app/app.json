{
  "expo": {
    "name": "SyncVibe",
    "slug": "syncvibe",
    "version": "1.29.2",
    "orientation": "portrait",
    "icon": "./assets/syncvibe.png",
    "scheme": "syncvibe",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": ["audio"]
      },
      "bundleIdentifier": "com.thakurdotdev.syncvibe"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/syncvibe.png",
        "backgroundColor": "#0B0B0C"
      },
      "package": "com.thakurdotdev.syncvibe",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "REQUEST_INSTALL_PACKAGES",
        "MODIFY_AUDIO_SETTINGS",
        "FOREGROUND_SERVICE",
        "POST_NOTIFICATIONS"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "syncvibe"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ],
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/syncvibe.png"
    },
    "plugins": [
      "expo-router",
      "expo-asset",
      "expo-image",
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/BricolageGrotesque_600SemiBold.ttf",
            "./assets/fonts/BricolageGrotesque_700Bold.ttf",
            "./assets/fonts/BricolageGrotesque_800ExtraBold.ttf"
          ]
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/syncvibe.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF",
          "dark": {
            "backgroundColor": "#0B0B0C"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "The app accesses your photos to let you share them with your friends."
        }
      ],
      [
        "expo-notifications",
        {
          "defaultChannel": "default",
          "enableBackgroundRemoteNotifications": true
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow SyncVibe to access your camera to capture and share moments.",
          "recordAudioAndroid": false
        }
      ],
      "expo-media-library",
      "expo-system-ui",
      "expo-web-browser",
      "expo-secure-store",
      [
        "expo-audio",
        {
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": false,
          "supportsPictureInPicture": false
        }
      ],
      "react-native-nitro-google-signin"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "b578a8f2-2ffd-443b-a957-f8043828d5fe"
      }
    },
    "owner": "thakurdotdev"
  }
}
